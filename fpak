{
   "app-id":  "app.shaz.pianocheetah",
   "command": "pianocheetah",
   "sdk":     "org.kde.Sdk",
   "runtime": "org.kde.Platform",
   "runtime-version":          "6.11",
   "finish-args": [
      "--filesystem=xdg-run/pipewire-0",
      "--share=ipc",
      "--share=network",
      "--device=dri",
      "--socket=wayland",
      "--socket=fallback-x11",
      "--socket=pulseaudio"
   ],
   "build-options" : {
      "strip": true,
      "no-debuginfo": true
   },
   "modules": [
      {
         "name": "pianocheetah",
         "buildsystem": "simple",
         "build-commands": [
            "_fpak/fp-build.sh"
         ],
         "sources": [
            {"type": "dir", "path": "."},
            {"type": "dir", "path": "../stv", "dest": "stv"}
         ]
      }
   ]
}
