{
   "app-id":  "app.shaz.pianocheetah",
   "command": "pianocheetah",
   "sdk":     "org.kde.Sdk",
   "runtime": "org.kde.Platform",
   "runtime-version": "6.11",
   "finish-args": [
      "--filesystem=xdg-run/pipewire-0",
      "--share=ipc",
      "--device=dri",
      "--socket=wayland",
      "--socket=fallback-x11",
      "--socket=pulseaudio"
   ],
   "build-options" : {
      "strip": true,
      "no-debuginfo": true
   },
   "modules": [
      {
         "name": "pianocheetah",
         "buildsystem": "simple",
         "build-commands": [
            "sh _fpak/fp-build.sh Release"
         ],
         "sources": [
            {
               "type":   "git",
               "url":    "https://github.com/Stephen-Hazel/pianocheetah.git",
               "tag":    "2026-09-15",
               "commit": "2a9158203674b2b0b16efac6f9d4689df3a54247"
            },
            {
               "type":   "git",
               "dest":   "stv",
               "url":    "https://github.com/Stephen-Hazel/stv.git",
               "tag":    "2026-09-15",
               "commit": "d51e11fa124495bbaf2afdac0a406ce55a0b0faf"
            }
         ]
      }
   ]
}
