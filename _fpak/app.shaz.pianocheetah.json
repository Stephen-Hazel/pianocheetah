{
   "app-id":  "app.shaz.pianocheetah",
   "command": "pianocheetah",
   "sdk":     "org.kde.Sdk",
   "runtime": "org.kde.Platform",
   "runtime-version": "6.11",
   "finish-args": [
      "--filesystem=xdg-run/pipewire-0",
      "--share=ipc",
      "--share=network",
      "--device=dri",
      "--socket=wayland",
      "--socket=fallback-x11",
      "--socket=pulseaudio"
   ],
   "build-options" : {
      "strip": true,
      "no-debuginfo": true
   },
   "modules": [
      {
         "name": "pianocheetah",
         "buildsystem": "simple",
         "build-commands": [
            "sh _fpak/fp-build.sh"
         ],
         "sources": [
            {
               "type":   "git",
               "url":    "https://github.com/Stephen-Hazel/pianocheetah.git",
               "tag":    "2026-09-15b",
               "commit": "6c4801ca18f06bb21196e61ee479617526e36c87"
            },
            {
               "type":   "git",
               "dest":   "stv",
               "url":    "https://github.com/Stephen-Hazel/stv.git",
               "tag":    "2026-09-15",
               "commit": "7ecbe1ceaba7246fa56ee4bd0d24cdf525181a56"
            }
         ]
      }
   ]
}
