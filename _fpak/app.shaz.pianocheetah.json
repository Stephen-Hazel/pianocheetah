{
   "app-id":  "app.shaz.pianocheetah",
   "command": "pianocheetah",
   "sdk":     "org.kde.Sdk",
   "runtime": "org.kde.Platform",
   "runtime-version": "6.11",
   "finish-args": [
      "--filesystem=xdg-run/pipewire-0",
      "--share=ipc",
      "--share=network",
      "--device=dri",
      "--socket=wayland",
      "--socket=fallback-x11",
      "--socket=pulseaudio"
   ],
   "build-options" : {
      "strip": true,
      "no-debuginfo": true
   },
   "modules": [
      {
         "name": "pianocheetah",
         "buildsystem": "simple",
         "build-commands": [
            "cp -pr _fpak/share /app",
            "for d in pianocheetah midicfg initme mid2song txt2song mod2song ll sfz2syn synsnd midimp song2wav; do ln -sfn ../stv $d/stv && cmake -G Ninja -S $d -B _b/$d -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/app && cmake --build _b/$d && cmake --install _b/$d || exit 1; done"
         ],
         "sources": [
            {
               "type":   "git",
               "url":    "https://github.com/Stephen-Hazel/pianocheetah.git",
               "tag":    "2026-09-15",
               "commit": "57bd6b26921cf03e0956b3e1b98d57b0666f10fe"
            },
            {
               "type":   "git",
               "dest":   "stv",
               "url":    "https://github.com/Stephen-Hazel/stv.git",
               "tag":    "2026-09-15",
               "commit": "7ecbe1ceaba7246fa56ee4bd0d24cdf525181a56"
            }
         ]
      }
   ]
}
