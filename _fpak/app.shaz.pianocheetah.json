{
   "app-id":  "app.shaz.pianocheetah",
   "command": "pianocheetah",
   "sdk":     "org.kde.Sdk",
   "runtime": "org.kde.Platform",
   "runtime-version": "6.11",
   "finish-args": [
      "--filesystem=xdg-run/pipewire-0",
      "--share=ipc",
      "--device=dri",
      "--socket=wayland",
      "--socket=fallback-x11",
      "--socket=pulseaudio"
   ],
   "build-options" : {
      "cflags": "-O2 -g",
      "cxxflags": "-O2 -g",
      "env": {
         "V": "1"
      },
      "arch": {
         "x86_64": {
            "cflags": "-O3 -g"
         }
      }
   },
   "modules": [
      {
         "name": "pianocheetah",
         "buildsystem": "simple",
         "build-commands": [
            "sh _fpak/fp-build.sh"
         ],
         "sources": [
            {
               "type":   "git",
               "url":    "https://github.com/Stephen-Hazel/pianocheetah.git",
               "tag":    "release-2026-11-10",
               "commit": "40db2832412c263e275a46459ed3e37524ec8087"
            },
            {
               "type":   "git",
               "dest":   "stv",
               "url":    "https://github.com/Stephen-Hazel/stv.git",
               "tag":    "release-2026-10-24",
               "commit": "7e01da264e2720b5f7058708688d8bb5c31d2c45"
            }
         ]
      }
   ]
}
