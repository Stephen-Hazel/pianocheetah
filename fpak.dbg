{
 "app-id":  "app.shaz.pianocheetah",
 "command": "pianocheetah",
 "sdk":     "org.kde.Sdk",
 "runtime": "org.kde.Platform",
 "runtime-version":          "6.11",
 "finish-args": [
  "--filesystem=xdg-run/pipewire-0",
  "--share=ipc",
  "--share=network",
  "--device=dri",
  "--socket=wayland",
  "--socket=fallback-x11",
  "--socket=pulseaudio"
 ],
    "build-options" : {
        "cflags": "-O2 -g",
        "cxxflags": "-O2 -g",
        "env": {
            "V": "1"
        },
        "arch": {
            "x86_64": {
                "cflags": "-O3 -g"
            }
        }
    },
 "modules": [
  {
   "name": "pianocheetah",
   "buildsystem": "cmake-ninja",
   "config-opts": ["-DCMAKE_BUILD_TYPE=Debug"],
   "sources": [
    {"type": "dir", "path": "pianocheetah"},
    {"type": "dir", "path": "../stv", "dest": "stv"}
   ]
  },
  {
   "name": "midicfg",
   "buildsystem": "cmake-ninja",
   "config-opts": ["-DCMAKE_BUILD_TYPE=Debug"],
   "sources": [
    {"type": "dir", "path": "pianocheetah"},
    {"type": "dir", "path": "../stv", "dest": "stv"}
   ]
  },
  {
   "name": "initme",
   "buildsystem": "cmake-ninja",
   "config-opts": ["-DCMAKE_BUILD_TYPE=Debug"],
   "sources": [
    {"type": "dir", "path": "pianocheetah"},
    {"type": "dir", "path": "../stv", "dest": "stv"}
   ]
  },

  {
   "name": "mid2song",
   "buildsystem": "cmake-ninja",
   "config-opts": ["-DCMAKE_BUILD_TYPE=Debug"],
   "sources": [
    {"type": "dir", "path": "pianocheetah"},
    {"type": "dir", "path": "../stv", "dest": "stv"}
   ]
  },
  {
   "name": "txt2song",
   "buildsystem": "cmake-ninja",
   "config-opts": ["-DCMAKE_BUILD_TYPE=Debug"],
   "sources": [
    {"type": "dir", "path": "pianocheetah"},
    {"type": "dir", "path": "../stv", "dest": "stv"}
   ]
  },
  {
   "name": "mod2song",
   "buildsystem": "cmake-ninja",
   "config-opts": ["-DCMAKE_BUILD_TYPE=Debug"],
   "sources": [
    {"type": "dir", "path": "pianocheetah"},
    {"type": "dir", "path": "../stv", "dest": "stv"}
   ]
  },
  {
   "name": "ll",
   "buildsystem": "cmake-ninja",
   "config-opts": ["-DCMAKE_BUILD_TYPE=Debug"],
   "sources": [
    {"type": "dir", "path": "pianocheetah"},
    {"type": "dir", "path": "../stv", "dest": "stv"}
   ]
  },
  {
   "name": "sfz2syn",
   "buildsystem": "cmake-ninja",
   "config-opts": ["-DCMAKE_BUILD_TYPE=Debug"],
   "sources": [
    {"type": "dir", "path": "pianocheetah"},
    {"type": "dir", "path": "../stv", "dest": "stv"}
   ]
  },
  {
   "name": "synsnd",
   "buildsystem": "cmake-ninja",
   "config-opts": ["-DCMAKE_BUILD_TYPE=Debug"],
   "sources": [
    {"type": "dir", "path": "pianocheetah"},
    {"type": "dir", "path": "../stv", "dest": "stv"}
   ]
  },
  {
   "name": "midimp",
   "buildsystem": "cmake-ninja",
   "config-opts": ["-DCMAKE_BUILD_TYPE=Debug"],
   "sources": [
    {"type": "dir", "path": "pianocheetah"},
    {"type": "dir", "path": "../stv", "dest": "stv"}
   ]
  },
  {
   "name": "song2wav",
   "buildsystem": "cmake-ninja",
   "config-opts": ["-DCMAKE_BUILD_TYPE=Debug"],
   "sources": [
    {"type": "dir", "path": "pianocheetah"},
    {"type": "dir", "path": "../stv", "dest": "stv"}
   ]
  },

  {
   "name": "_fpak",
   "buildsystem": "simple",
   "build-commands": [ "cp -pr share /app" ],
   "sources": [ {"type": "dir", "path": "_fpak"} ]
  }
 ]
}
